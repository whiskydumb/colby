# build
/target
**/*.rs.bk

# what running the engine leaves behind. The console archive is a user file
# rather than a derived one, which is why it stays in the project root and out
# of the derived directories: cargo clean should not take somebody's settings.
# Saved scenes are the same kind of thing and are there for the same reason.
# colby.png is what `just shot` writes when nobody names a path. `.colby/` is
# what the engine derives for a project - the compiled assets - and
# `just clean` takes it.
/settings.cfg
/colby.png
/saves/
/.colby/

# secrets and local overrides
.env
.env.*
!.env.example
.cargo/credentials*

# coverage
*.profraw
/coverage
lcov.info

# profiling
*.mm_profdata
flamegraph.svg
perf.data*

# rustc crash dumps
rustc-ice-*

# patch and merge leftovers
*.orig
*.rej

# nix
/result*

# a rigged model used to drive the skinning work; not colby's to redistribute
/assets/models/rig_test.glb
