# a quartz crystal: a hexagonal column with a point on each end.
#
# Edit this and save it. The runner recompiles it into
# target/assets/meshes/crystal.cmesh and reloads the mesh without restarting,
# so the shape on screen changes while the process keeps its camera, its
# entities and its frame count.
#
# Things worth trying: move the two apex vertices further out to sharpen the
# points, or push the rings apart to make the column taller. Coordinates are
# right-handed with y up, and faces are counter-clockwise seen from outside —
# reverse a face's corners and it disappears into the back-face cull.
#
# No `vn` lines, on purpose: every face gets the normal its own winding
# implies, which is what makes the facets read as facets.

# the upper ring, y = 0.5
v  0.500000  0.500000  0.000000
v  0.250000  0.500000  0.433013
v -0.250000  0.500000  0.433013
v -0.500000  0.500000  0.000000
v -0.250000  0.500000 -0.433013
v  0.250000  0.500000 -0.433013

# the lower ring, y = -0.5
v  0.500000 -0.500000  0.000000
v  0.250000 -0.500000  0.433013
v -0.250000 -0.500000  0.433013
v -0.500000 -0.500000  0.000000
v -0.250000 -0.500000 -0.433013
v  0.250000 -0.500000 -0.433013

# the points
v  0.000000  1.150000  0.000000
v  0.000000 -1.150000  0.000000

o crystal

# the six faces of the column
g column
f 7 1 2 8
f 8 2 3 9
f 9 3 4 10
f 10 4 5 11
f 11 5 6 12
f 12 6 1 7

# the upper point
g cap_top
f 1 13 2
f 2 13 3
f 3 13 4
f 4 13 5
f 5 13 6
f 6 13 1

# the lower point
g cap_bottom
f 7 8 14
f 8 9 14
f 9 10 14
f 10 11 14
f 11 12 14
f 12 7 14
